{
  "name": "olimpia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:marketing": "npm run dev -w @olimpia/marketing",
    "build:marketing": "npm run build -w @olimpia/marketing",
    "start:marketing": "npm run start -w @olimpia/marketing",
    "dev:api": "npm run dev -w @olimpia/api",
    "build:api": "npm run build -w @olimpia/api",
    "start:api": "npm run start -w @olimpia/api",
    "migrate:api": "npm run migrate -w @olimpia/api",
    "dev:mobile": "npm run start -w @olimpia/mobile",
    "start:mobile": "npm run start -w @olimpia/mobile"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "expo": "52.0.49",
    "react-native": "0.76.9"
  }
}
