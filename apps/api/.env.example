# Copy to .env.local (or .env) — never commit real secrets.

NODE_ENV=development
PORT=3001

# PostgreSQL — required for migrations and database health check
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olimpia_dev

# Privy — REQUIRED for V1 (auth sync, /me, embedded wallet, USDC balance)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Read-only Privy Earn product configuration (Aave / Base / USDC)
PRIVY_EARN_AAVE_BASE_USDC_VAULT_ID=

# Optional Base RPC for smart-wallet USDC reads. Defaults to public Base mainnet RPC.
# Server-only. Never a Paymaster URL.
BASE_RPC_URL=

# 3C.3: Smart Wallet Aave deposits. Default off. Do not enable until a live send is approved.
# Never a Paymaster URL.
AAVE_SMART_WALLET_DEPOSITS_ENABLED=false

# Comma-separated origins for mobile/web dev clients
CORS_ORIGINS=

# V1 funding is Receive USDC on Base into the Privy wallet. No fiat provider is required.
# FUNDING_PROVIDER=bridge is rejected — Bridge was removed and is not an active provider.
#
# Unset means no auto-crediting mock. Do not default this to mock.
# FUNDING_PROVIDER=mock is refused unless NODE_ENV is development or test.
# Staging and production must not use mock (boot fails if they do).
#
# Post-V1 optional — Coinbase Headless Add Money (not a V1 launch dependency):
#   FUNDING_PROVIDER=coinbase  plus the COINBASE_* credentials below.
# Local Add Money UI tests (post-V1 code path only): FUNDING_PROVIDER=mock
FUNDING_PROVIDER=
COINBASE_ONRAMP_API_KEY=
COINBASE_ONRAMP_API_SECRET=
COINBASE_WEBHOOK_SECRET=
# CDP Portal only — not loaded by the API. Needed when creating the webhook subscription.
# COINBASE_PROJECT_ID=
# true = sandbox partnerUserRef + useApplePaySandbox. Defaults to true outside production.
COINBASE_SANDBOX=

# Transactional email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
