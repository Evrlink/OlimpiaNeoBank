# Copy to .env.local (or .env) — never commit real secrets.

NODE_ENV=development
PORT=3001

# PostgreSQL — required for migrations and database health check
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olimpia_dev

# Privy — required for auth sync and /me
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Comma-separated origins for mobile/web dev clients
CORS_ORIGINS=

# Funding / Add Money
# mock = local E2E without Coinbase (default in development when COINBASE_ONRAMP_API_KEY is empty)
# coinbase = Coinbase Headless Onramp (required in production)
# FUNDING_PROVIDER=bridge is rejected — Bridge was removed from the V1 architecture
FUNDING_PROVIDER=
COINBASE_ONRAMP_API_KEY=
COINBASE_ONRAMP_API_SECRET=
COINBASE_WEBHOOK_SECRET=
# CDP Portal only — not loaded by the API. Needed when creating the webhook subscription.
# COINBASE_PROJECT_ID=
# true = sandbox partnerUserRef + useApplePaySandbox. Defaults to true outside production.
COINBASE_SANDBOX=

# Transactional email (optional in mock; required for production deposit confirmations)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
