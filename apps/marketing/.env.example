# Supabase (preferred marketing waitlist storage)
# Run apps/marketing/supabase/waitlist_emails.sql in the Supabase SQL editor.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional — SEO / canonical URLs
# VITE_SITE_URL=https://yourdomain.com
# VITE_SUPPORT_EMAIL=hello@yourdomain.com

# Optional — inbox fallback when Supabase insert fails (defaults to VITE_SUPPORT_EMAIL / hello@olimpia.app)
# VITE_WAITLIST_NOTIFY_EMAIL=hello@olimpia.app
