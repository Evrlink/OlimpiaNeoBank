# (server: WAITLIST_NOTIFY_EMAIL, client fallback: VITE_WAITLIST_NOTIFY_EMAIL)
# WAITLIST_NOTIFY_EMAIL=you@example.com
# VITE_WAITLIST_NOTIFY_EMAIL=you@example.com

# Optional — SEO / canonical URLs
# VITE_SITE_URL=https://yourdomain.com
# VITE_SUPPORT_EMAIL=hello@yourdomain.com

# Optional legacy Supabase waitlist (currently unused; project must be reachable)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
