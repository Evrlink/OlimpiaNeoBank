{
  "expo": {
    "name": "Olimpia",
    "slug": "olimpia",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "olimpia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.olimpia.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Olimpia uses the camera to scan wallet QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4F1"
      },
      "package": "app.olimpia.mobile"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Olimpia uses the camera to scan wallet QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
